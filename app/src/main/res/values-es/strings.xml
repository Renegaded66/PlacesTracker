    <!-- Help Dialog Content -->
    <string name="help_local_title">100% Local y Privado</string>
    <string name="help_local_desc">Tus datos te pertenecen. PlacesTracker guarda todas las experiencias, imágenes y datos GPS exclusivamente de forma local en tu dispositivo. No hay comunicación con ningún servidor y no se suben datos personales a la nube.</string>

    <string name="help_types_title">Experiencia vs. Viaje</string>
    <string name="help_types_desc">Una experiencia es un solo lugar con imágenes y notas.\n\nUn viaje, por el contrario, es un recorrido completo con varias paradas. Durante un viaje activo, la aplicación registra puntos de ruta en segundo plano para que puedas reconstruir tu trayecto con precisión más tarde.</string>

    <string name="help_auto_trip_title">Viaje automático</string>
    <string name="help_auto_trip_desc">¿No quieres añadir cada parada manualmente? ¡Usa la automatización! Simplemente selecciona varias imágenes de tu galería. Un algoritmo inteligente analiza los datos de ubicación y tiempo, agrupa las imágenes por ubicación en paradas y crea una ruta completa que incluye los nombres de las ciudades.</string>

    <string name="help_friends_title">Sistema de amigos</string>
    <string name="help_friends_desc">Puedes compartir tus viajes y experiencias con amigos enviando un archivo compartido. Las experiencias importadas de tus amigos aparecen en un feed separado. Lo mejor: si estuviste en un viaje, puedes copiarlo directamente a tu propio feed usando el icono del más.</string>

    <string name="help_calendar_title">Vista de calendario</string>
    <string name="help_calendar_desc">En la vista de calendario tienes un resumen cronológico perfecto. Los días en los que tuviste experiencias o estuviste de viaje están marcados. Así podrás saber rápidamente qué hiciste en un día concreto el año pasado.</string>

    <string name="help_stats_title">Estadísticas</string>
    <string name="help_stats_desc">¿Cuántos kilómetros has recorrido este año? ¿Cuántos países has visitado ya? La vista de estadísticas analiza tus viajes y experiencias y te muestra datos interesantes sobre tu comportamiento de viaje.</string>

    <string name="help_bucket_title">Lista de deseos</string>
    <string name="help_bucket_desc">¡Planifica tus sueños! En la lista de deseos puedes guardar los lugares que quieras visitar. En cuanto asignes una fecha a un elemento, este se convertirá automáticamente en una experiencia planificada en tu feed.</string>

    <string name="help_auto_detect_title">Detección automática</string>
    <string name="help_auto_detect_desc">La aplicación puede escanear regularmente tu galería en segundo plano en busca de nuevas imágenes. Si haces fotos a más de X kilómetros de tu ubicación de casa, PlacesTracker te sugerirá automáticamente crear una nueva experiencia.</string>

    <string name="help_backup_title">Sistema de copia de seguridad</string>
    <string name="help_backup_desc">¡La seguridad es lo primero! A través del sistema de copia de seguridad puedes exportar toda tu base de datos, incluyendo todas las conexiones, a un archivo. Así podrás llevarte tus datos fácilmente cuando cambies de dispositivo o hacer copias de seguridad periódicas.</string>

    <string name="help_personalize_title">Personalización y línea de tiempo</string>
    <string name="help_personalize_desc">Elige tu propio tema e idioma. La galería de la línea de tiempo también escanea toda tu colección de fotos locales, muestra cada imagen en el lugar donde fue tomada en un globo 3D interactivo y te permite viajar visualmente por tu pasado.</string>

    <string name="help_donate_title">Apoyar el desarrollo</string>
    <string name="help_donate_desc">PlacesTracker es un proyecto personal y completamente libre de publicidad. Si te gusta la aplicación, puedes apoyar el desarrollo con una pequeña donación. ¡Muchas gracias!</string>
