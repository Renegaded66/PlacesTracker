    <!-- Help Dialog Content -->
    <string name="help_local_title">100% Local &amp; Private</string>
    <string name="help_local_desc">Your data belongs to you. PlacesTracker stores all experiences, images and GPS data exclusively locally on your device. There is no communication with any server and no personal data is uploaded to the cloud.</string>

    <string name="help_types_title">Experience vs Trip</string>
    <string name="help_types_desc">An experience is a single place with images and notes.\n\nA trip is a full journey with multiple stops. While an active trip, the app records waypoints in the background so you can later trace your route precisely.</string>

    <string name="help_auto_trip_title">Automatic Trip</string>
    <string name="help_auto_trip_desc">Don’t want to add every stop manually? Use automation! Simply select multiple images from your gallery. A smart algorithm analyzes location and time data, groups images by location into stops, and creates a complete route including city names.</string>

    <string name="help_friends_title">Friends System</string>
    <string name="help_friends_desc">You can share your trips and experiences with friends by sending a share file. Imported experiences from friends appear in a separate feed. Best part: if you joined a trip, you can copy it directly into your own feed using the plus icon.</string>

    <string name="help_calendar_title">Calendar View</string>
    <string name="help_calendar_desc">The calendar view gives you a perfect timeline overview. Days with experiences or trips are marked, so you can quickly see what you did on a specific day in previous years.</string>

    <string name="help_stats_title">Statistics</string>
    <string name="help_stats_desc">How many kilometers did you travel this year? How many countries have you visited? The statistics view analyzes your trips and experiences and shows interesting insights about your travel behavior.</string>

    <string name="help_bucket_title">Bucket List</string>
    <string name="help_bucket_desc">Plan your dreams! In the bucket list you can save places you definitely want to visit. Once you assign a date, the item automatically becomes a planned experience in your feed.</string>

    <string name="help_auto_detect_title">Automatic Detection</string>
    <string name="help_auto_detect_desc">The app can regularly scan your gallery in the background for new images. If you take photos more than X kilometers away from your home location, PlacesTracker automatically suggests creating a new experience.</string>

    <string name="help_backup_title">Backup System</string>
    <string name="help_backup_desc">Safety first! The backup system lets you export your entire database including all connections into a file. This makes it easy to restore your data on a new device or keep regular backups.</string>

    <string name="help_personalize_title">Customization &amp; Timeline</string>
    <string name="help_personalize_desc">Choose your own theme and language. The timeline gallery also scans your entire local photo collection, displays each image at its capture location on an interactive 3D globe, and lets you visually explore your past.</string>

    <string name="help_donate_title">Support Development</string>
    <string name="help_donate_desc">PlacesTracker is a passion project and completely ad-free. If you like the app, you can support its development with a small donation. Thank you!</string>
