<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/detailRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <!-- Reihenfolge = Z-Ordnung (alles ohne Elevation, kein Shadow-Balken ueber dem Hero):
         1. NestedScrollView (unten)   2. Toolbar (davor)   3. Drag-Handle (ganz vorn) -->

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/llDetailContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- Hero-Galerie: full-bleed (startet HINTER Toolbar/Handle), unten abgerundet, 400dp -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvHeroMedia"
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:clipChildren="true"
                android:clipToPadding="true"
                app:cardElevation="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.HeroBottom"
                app:strokeWidth="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/heroMediaPager"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <!-- Oben dunkel: Toolbar-Icons bleiben lesbar ueber hellem Bild -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:layout_gravity="top"
                        android:background="@drawable/bg_scrim_top" />

                    <!-- Unten dunkel: Dots/Zaehler lesbar -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_gravity="bottom"
                        android:background="@drawable/bg_feed_card_gradient" />

                    <!-- Bild-Zähler: dezente Pille oben rechts -->
                    <TextView
                        android:id="@+id/tvMediaCounter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="16dp"
                        android:background="@drawable/bg_media_counter"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="2/5" />

                    <!-- Dots unten: aktiver Dot dehnt sich zur Pille (Instagram-Stil) -->
                    <LinearLayout
                        android:id="@+id/heroDotsIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="14dp"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="4dp" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Kopfzeile: Ort, Titel, Datum/Wetter -->
            <LinearLayout
                android:id="@+id/llHeaderSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="18dp">

                <!-- Ortszeile: Flagge + Landname (Theme-Farbe) -->
                <LinearLayout
                    android:id="@+id/llLocationLine"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvFlag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        tools:text="\uD83C\uDDE9\uD83C\uDDEA" />

                    <TextView
                        android:id="@+id/tvCountryName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:letterSpacing="0.04"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="Deutschland" />
                </LinearLayout>

                <!-- Titel -->
                <TextView
                    android:id="@+id/tvDetailTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:letterSpacing="-0.02"
                    android:lineSpacingMultiplier="1.1"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    tools:text="Titel des Ortes" />

                <!-- Info-Zeile: Datum · Wetter mit Icons -->
                <LinearLayout
                    android:id="@+id/llInfoRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/ivCalendarIcon"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="@string/weather_icon"
                        android:src="@drawable/ic_calendar" />

                    <TextView
                        android:id="@+id/tvDetailDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="14sp"
                        tools:text="Sonntag, 12. Mai 2024" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="10dp"
                        android:text="@string/detail_info_divider"
                        android:textColor="?attr/colorOutlineVariant"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:id="@+id/llWeather"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/ivWeatherIcon"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="@string/weather_icon" />

                        <TextView
                            android:id="@+id/tvWeatherTemp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            tools:text="21\u00B0C" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Globe-Hinweis (nur inline): laedt ein, das Sheet nach unten zu ziehen -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cvGlobeHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="18dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="9dp">

                        <ImageView
                            android:id="@+id/ivGlobeHintIcon"
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:contentDescription="@string/weather_icon"
                            android:src="@drawable/ic_location" />

                        <TextView
                            android:id="@+id/tvGlobeHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/view_on_globe_hint"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Notizen: Journal-Stil mit Akzentbalken -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvDetailNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:orientation="horizontal"
                    android:padding="18dp">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="match_parent"
                        android:background="?attr/colorPrimary" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.12"
                            android:text="@string/notes"
                            android:textAllCaps="true"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDetailNotes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingMultiplier="1.45"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="15sp"
                            tools:text="Hier stehen die Notizen zum Ort..." />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Schwebende Toolbar: liegt UEBER dem ScrollView (Hero laeuft dahinter durch),
         transparent beim Start, Scrim-Flaeche blendet beim Scrollen ein (DetailChrome).
         Ohne elevation: kein Shadow-Balken ueber dem Hero-Bild. -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_scrim_toolbar"
        android:elevation="0dp"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title=""
            app:titleTextColor="?attr/colorOnSurface"/>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Drag Handle: ganz oben, signalisiert die ziehbare Sheet-Kante -->
    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:id="@+id/drag_handle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>